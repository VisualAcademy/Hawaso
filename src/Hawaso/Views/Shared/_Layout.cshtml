@inject Azunt.Services.Terminology.ITerminologyService T
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @T.Get("ProductName")</title>
    <link rel="stylesheet" href="~/templates/landing/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/azunt-landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/azunt-hawaso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/memoengine.pager.css" />
    <link rel="stylesheet" href="~/css/dul/dul-dropdown.css" />
    <link rel="stylesheet" href="~/css/open-iconic/font/css/open-iconic-bootstrap.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="az-public-body" data-az-shell="landing" data-az-shell-mode="mvc">
    @await Html.PartialAsync("~/Views/Shared/_AzPublicHeader.cshtml")
    <main id="az-public-main">@RenderBody()</main>
    @await Html.PartialAsync("~/Views/Shared/_AzPublicFooter.cshtml")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/dul/dul-dropdown.js"></script>
    <script src="~/js/azunt-landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/az-auth-ping.js"></script>
</body>
</html>
