@page "/fluent-tabs-demo"

@using Microsoft.FluentUI.AspNetCore.Components

<h3>FluentTabs Demo</h3>

<FluentTabs>
    <FluentTab Id="attachment">
        <HeaderTemplate>
            <h4>
                <FluentIcon Value="@(new Icons.Regular.Size24.Attach())" />
                Attachment
            </h4>
        </HeaderTemplate>

        <ChildContent>
            <FluentCard Height="500px">
                Attachment List 1
            </FluentCard>
        </ChildContent>
    </FluentTab>

    <FluentTab Id="software-install">
        <HeaderTemplate>
            <h4>
                <FluentIcon Value="@(new Icons.Regular.Size24.AppGeneric())"
                            Color="@Color.Success" />
                Software Install
            </h4>
        </HeaderTemplate>

        <ChildContent>
            <FluentCard Height="500px">
                Attachment List 2
            </FluentCard>
        </ChildContent>
    </FluentTab>

    <FluentTab Id="hardware-history">
        <HeaderTemplate>
            <h4>
                <FluentIcon Value="@(new Icons.Regular.Size24.History())"
                            Color="@Color.Error" />
                History
            </h4>
        </HeaderTemplate>

        <ChildContent>
            <FluentCard Height="500px">
                Attachment List 2
            </FluentCard>
        </ChildContent>
    </FluentTab>
</FluentTabs>