@page "/Manufacturers"

@using Hawaso.Models
@using Dul.Web

@* Open XML SDK *@
@using DocumentFormat.OpenXml
@using DocumentFormat.OpenXml.Packaging
@using DocumentFormat.OpenXml.Spreadsheet

@inject IManufacturerRepository repository
@inject IJSRuntime JS
@inject IToastService toastService

@attribute [AllowAnonymous]
@attribute [Authorize(Roles = "Administrators")]

<PageTitle>제조사 리스트 | Hawaso</PageTitle>

<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">

                <h3>Manufacturer List</h3>

                <p>제조사 목록을 관리합니다.</p>

                @if (manufacturers is null)
                {
                    <p>
                        <em>Loading...</em>
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="text-nowrap text-center">
                                        ID
                                    </th>
                                    <th class="text-nowrap text-center">
                                        Name
                                    </th>
                                    <th class="text-nowrap text-center">
                                        Manufacturer Code
                                    </th>
                                    <th class="text-nowrap text-center">
                                        Comment
                                    </th>
                                    <th class="text-nowrap text-center">
                                        Edit
                                    </th>
                                    <th class="text-nowrap text-center">
                                        Delete
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in manufacturers)
                                {
                                    <tr>
                                        <td class="text-nowrap text-center">
                                            @item.Id
                                        </td>

                                        <td class="text-nowrap text-center">
                                            @item.Name
                                        </td>

                                        <td class="text-nowrap text-center">
                                            @item.ManufacturerCode
                                        </td>

                                        <td class="text-nowrap text-center">
                                            @item.Comment
                                        </td>

                                        <td class="text-nowrap text-center">
                                            <input type="button"
                                                   value="Edit"
                                                   class="btn btn-primary"
                                                   data-toggle="modal"
                                                   data-target="#manufacturerEditorDialog"
                                                   @onclick="@(() => EditBy(item))" />
                                        </td>

                                        <td class="text-nowrap text-center">
                                            <input type="button"
                                                   value="Delete"
                                                   class="btn btn-danger"
                                                   data-toggle="modal"
                                                   data-target="#manufacturerDeleteDialog"
                                                   @onclick="@(() => DeleteBy(item))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <ManufacturerPager Model="pager"
                                   PageIndexChanged="PageIndexChanged">
                </ManufacturerPager>

                <div>
                    <input type="button"
                           value="Add"
                           class="btn btn-primary"
                           data-toggle="modal"
                           data-target="#manufacturerEditorDialog"
                           @onclick="btnCreate_Click" />

                    <button type="button"
                            class="btn btn-primary pull-right"
                            @onclick="DownloadFile">
                        Download
                    </button>
                </div>

                <ManufacturerDeleteDialog OnClick="btnDelete_Click">
                </ManufacturerDeleteDialog>

                <ManufacturerEditorForm EditorModel="manufacturer"
                                        SaveOrUpdated="SaveOrUpdated">
                    <EditorFormTitle>
                        @editorFormTitle
                    </EditorFormTitle>
                </ManufacturerEditorForm>

            </div>
        </div>
    </div>
</div>

@code {
    private readonly PagerBase pager = new()
    {
        PageNumber = 1,
        PageIndex = 0,
        PageSize = 20,
        PagerButtonCount = 5
    };

    private string editorFormTitle = string.Empty;

    // 데이터 로딩 전에는 null 상태를 사용합니다.
    private List<Manufacturer>? manufacturers;

    // 현재 선택된 제조사입니다.
    private Manufacturer manufacturer = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var pagingData = await repository.GetAllByPageAsync(
            pager.PageIndex,
            pager.PageSize);

        pager.RecordCount = pagingData.TotalRecords;
        manufacturers = pagingData.Records.ToList();
    }

    protected void btnCreate_Click()
    {
        editorFormTitle = "Create";
        manufacturer = new Manufacturer();
    }

    protected async Task btnDelete_Click()
    {
        await repository.DeleteManufacturerAsync(manufacturer.Id);

        await JS.InvokeAsync<object>(
            "closeModal",
            "manufacturerDeleteDialog");

        manufacturer = new Manufacturer();

        await LoadDataAsync();

        toastService.ShowError("삭제되었습니다.");
    }

    private void DeleteBy(Manufacturer selectedManufacturer)
    {
        manufacturer = selectedManufacturer;
    }

    private void EditBy(Manufacturer selectedManufacturer)
    {
        editorFormTitle = "Edit";
        manufacturer = selectedManufacturer;
    }

    // ManufacturerEditorForm의 콜백 형식과 호환되도록
    // async void를 유지합니다.
    private async void SaveOrUpdated()
    {
        await LoadDataAsync();

        StateHasChanged();
    }

    // ManufacturerPager의 콜백 형식과 호환되도록
    // async void를 유지합니다.
    private async void PageIndexChanged(int pageIndex)
    {
        pager.PageIndex = pageIndex;
        pager.PageNumber = pageIndex + 1;

        await LoadDataAsync();

        StateHasChanged();
    }

    // ===== Excel (OpenXML) =====

    private void DownloadFile()
    {
        if (manufacturers is null || manufacturers.Count == 0)
        {
            toastService.ShowWarning("내려받을 데이터가 없습니다.");
            return;
        }

        byte[] bytes;

        using (var memoryStream = new MemoryStream())
        {
            using (var document = SpreadsheetDocument.Create(
                memoryStream,
                SpreadsheetDocumentType.Workbook,
                true))
            {
                var workbookPart = document.AddWorkbookPart();
                workbookPart.Workbook = new Workbook();

                var worksheetPart =
                    workbookPart.AddNewPart<WorksheetPart>();

                var sheetData = new SheetData();

                worksheetPart.Worksheet =
                    new Worksheet(sheetData);

                var sheets =
                    workbookPart.Workbook.AppendChild(new Sheets());

                sheets.Append(
                    new Sheet
                    {
                        Id = workbookPart.GetIdOfPart(worksheetPart),
                        SheetId = 1U,
                        Name = "Manufacturers"
                    });

                // Header
                const uint headerRowIndex = 1;

                var headerRow =
                    new Row
                    {
                        RowIndex = headerRowIndex
                    };

                sheetData.Append(headerRow);

                string[] headers =
                {
                    "Id",
                    "Name",
                    "ManufacturerCode",
                    "Comment"
                };

                for (var index = 0;
                     index < headers.Length;
                     index++)
                {
                    headerRow.Append(
                        TextCell(
                            Ref(
                                index + 1,
                                (int)headerRowIndex),
                            headers[index]));
                }

                // Data
                uint rowIndex = 2;

                foreach (var item in manufacturers)
                {
                    var row =
                        new Row
                        {
                            RowIndex = rowIndex
                        };

                    sheetData.Append(row);

                    var values = new[]
                    {
                        item.Id.ToString(),
                        item.Name ?? string.Empty,
                        item.ManufacturerCode ?? string.Empty,
                        item.Comment ?? string.Empty
                    };

                    for (var index = 0;
                         index < values.Length;
                         index++)
                    {
                        row.Append(
                            TextCell(
                                Ref(
                                    index + 1,
                                    (int)rowIndex),
                                values[index]));
                    }

                    rowIndex++;
                }

                worksheetPart.Worksheet.Save();
                workbookPart.Workbook.Save();
            }

            bytes = memoryStream.ToArray();
        }

        FileUtil.SaveAs(
            JS,
            $"{DateTime.Now:yyyyMMddHHmmss}_Manufacturers.xlsx",
            bytes);
    }

    private static Cell TextCell(
        string cellReference,
        string text)
    {
        return new Cell
        {
            CellReference = cellReference,
            DataType = CellValues.String,
            CellValue = new CellValue(
                text ?? string.Empty)
        };
    }

    private static string Ref(
        int columnIndex,
        int rowIndex)
    {
        return $"{ColName(columnIndex)}{rowIndex}";
    }

    private static string ColName(int index)
    {
        var dividend = index;
        var columnName = string.Empty;

        while (dividend > 0)
        {
            var modulo = (dividend - 1) % 26;

            columnName =
                (char)('A' + modulo) + columnName;

            dividend =
                (dividend - modulo) / 26;
        }

        return columnName;
    }
}