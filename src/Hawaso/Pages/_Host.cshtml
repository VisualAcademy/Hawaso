@page "/Dashboard"
@namespace Hawaso.Pages
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Authorization
@using Hawaso.Models.AzuntDashboard
@inject IAuthorizationService AuthorizationService
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var canViewAppLogs = (await AuthorizationService.AuthorizeAsync(User, "GlobalAdministrators")).Succeeded;
    var dashboardNavigation = DashboardNavigationCatalog.Build(HttpContext.Request.Path.Value, canViewAppLogs);
}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hawaso · Dashboard</title>
  <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />

  <base href="~/" />
  <link rel="stylesheet" href="_content/MatBlazor/dist/matBlazor.css" />
  <link rel="stylesheet" href="_content/ChartJs.Blazor/ChartJSBlazor.css" />
  <link rel="stylesheet" href="_content/Blazored.Toast/blazored-toast.min.css" />
  <link rel="stylesheet" href="~/css/open-iconic/font/css/open-iconic-bootstrap.min.css" />
  @* Keep Azunt shell styles after Bootstrap, MatBlazor and other library styles. *@
  <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-dashboard.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-hawaso.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-dashboard-compat.css" asp-append-version="true" />
  @* Keep Azunt navigation isolated from legacy button and link styles. *@

  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/js/all.min.js" crossorigin="anonymous"></script>
  <script src="_content/MatBlazor/dist/matBlazor.js"></script>
  <script src="_content/ChartJs.Blazor/moment-with-locales.min.js"></script>
  <script src="_content/ChartJs.Blazor/Chart.min.js"></script>
  <script src="_content/ChartJs.Blazor/ChartJsBlazorInterop.js"></script>
  <script src="/inputfile.js"></script>
  <script src="/saveAsFile.js"></script>
  <script src="~/js/site.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/azunt@1.1.1/src/azunt.js?t=now"></script>
  <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
  @* Sidebar color reset is deliberately inline: third-party/legacy rules and
     missing auxiliary static files must never unstyle the Azunt navigation. *@
  <meta name="azunt-sidebar-theme" content="20261122-v3-inline" />
  <style id="azunt-sidebar-critical-style" data-revision="20261122-v3">
    /*
     * Azunt portal sidebar critical navigation appearance (2026-11-22).
     * This rule set is intentionally limited to the sidebar/flyout; it must not
     * recolor the application content, Blazor controls, or Bootstrap buttons.
     */
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a, button, span).az-dashboard-nav-link,
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > a.az-dashboard-nav-link:link,
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > a.az-dashboard-nav-link:visited {
      -webkit-appearance: none !important;
      appearance: none !important;
      display: block !important;
      box-sizing: border-box !important;
      width: 100% !important;
      min-width: 0 !important;
      min-height: 44px !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      outline-offset: -2px;
      box-shadow: none !important;
      background: transparent !important;
      background-image: none !important;
      color: #e9f0f7 !important;
      font-family: inherit !important;
      font-size: 13px !important;
      font-weight: 400 !important;
      line-height: 1.25 !important;
      text-align: left !important;
      text-decoration: none !important;
      text-shadow: none !important;
      text-transform: none !important;
      white-space: nowrap !important;
      cursor: pointer;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a, button, span).az-dashboard-nav-link .az-dashboard-nav-link-inner {
      display: grid !important;
      grid-template-columns: 22px minmax(0, 1fr) !important;
      align-items: center !important;
      width: 100% !important;
      min-height: 44px !important;
      text-align: left !important;
      text-decoration: none !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a, button, span).az-dashboard-nav-link .az-dashboard-nav-text {
      color: inherit !important;
      text-decoration: none !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-node.az-is-active-branch > .az-dashboard-nav-row > .az-dashboard-nav-link:not(.az-is-current) {
      background: #384148 !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a, button, span).az-dashboard-nav-link:hover,
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a, button, span).az-dashboard-nav-link:focus-visible {
      background: #3b444b !important;
      color: #fff !important;
      text-decoration: none !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > .az-dashboard-nav-link.az-is-current {
      background: #46515a !important;
      color: #fff !important;
      font-weight: 600 !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > .az-dashboard-nav-link.az-is-unavailable {
      background: transparent !important;
      color: #9baab7 !important;
      opacity: .58 !important;
      cursor: not-allowed !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > button.az-dashboard-nav-toggle {
      -webkit-appearance: none !important;
      appearance: none !important;
      display: grid !important;
      place-items: center !important;
      min-height: 44px !important;
      border: 0 !important;
      border-radius: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      color: #afc3d5 !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > button.az-dashboard-nav-toggle:hover,
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > button.az-dashboard-nav-toggle:focus-visible {
      background: rgba(255,255,255,.045) !important;
      color: #fff !important;
    }
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > :is(a,button).az-dashboard-nav-link:focus-visible,
    body.az-dashboard-body :is(#portalSidebar, #dashboardNavFlyout) .az-dashboard-nav .az-dashboard-nav-row > button.az-dashboard-nav-toggle:focus-visible {
      outline: 2px solid #90cafa !important;
    }
  </style>

  <script id="azunt-document-navigation-v4">
    // MVC public pages must leave the Blazor router and request a fresh document.
    // Capture the click before Blazor's delegated navigation handler runs.
    (function () {
      document.addEventListener('click', function (event) {
        var target = event.target;
        var link = target && target.closest ? target.closest('a[data-az-document-nav]') : null;
        if (!link || event.defaultPrevented || event.button !== 0 ||
            event.ctrlKey || event.metaKey || event.shiftKey || event.altKey ||
            link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
        var url = new URL(link.href, document.baseURI);
        if (url.origin !== window.location.origin || !/^https?:$/.test(url.protocol)) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        window.location.assign(url.href);
      }, true);
    }());
  </script>
</head>
<body data-az-ui-revision="navigation-v4" class="az-dashboard-body" data-az-shell="dashboard" data-az-shell-mode="blazor-server">
  <header class="az-portal-topbar">
    <button id="appLauncherToggle"
            class="az-portal-app-launcher"
            type="button"
            aria-label="Open Hawaso apps"
            aria-controls="appLauncherMenu"
            aria-expanded="false"
            title="Apps">
      <span class="az-portal-waffle" aria-hidden="true">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </span>
    </button>
    <a class="az-portal-brand" href="/dashboard"><span class="az-brand-mark az-small">H</span><span>Hawaso Portal</span></a>
    <button id="sidebarToggle" class="az-portal-hamburger" type="button" aria-label="Hide navigation" title="Hide navigation" aria-expanded="true">
      <span></span><span></span><span></span>
    </button>
    <nav class="az-portal-shortcuts" aria-label="Portal shortcuts">
      <a href="/dashboard">⌂ Dashboard</a>
      <a href="/DotNetNote">＋ Board</a>
      <a href="/About">About</a>
    </nav>
    <div class="az-portal-actions">
      <a href="/Home" data-az-document-nav="true">Public site</a>
      <a class="az-avatar" href="/Identity/Account/Manage">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</a>
    </div>
  </header>

  <section id="appLauncherMenu" class="az-portal-app-menu" aria-hidden="true" aria-label="Azunt apps">
    <div class="az-portal-app-menu-header">
      <div>
        <strong>Hawaso</strong>
        <span>Sites and tools</span>
      </div>
      <a href="/Home" data-az-document-nav="true">Home</a>
    </div>

    <nav class="az-portal-app-grid" aria-label="Azunt applications">
      <a class="az-portal-app-item" href="/Home" data-az-document-nav="true">
        <span class="az-portal-app-icon az-app-icon-home"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#home"></use></svg></span>
        <span>Public site</span>
      </a>
      <a class="az-portal-app-item" href="/dashboard">
        <span class="az-portal-app-icon az-app-icon-dashboard"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#dashboard"></use></svg></span>
        <span>Dashboard</span>
      </a>
      <a class="az-portal-app-item" href="/dashboard/resources">
        <span class="az-portal-app-icon az-app-icon-resources"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#resources"></use></svg></span>
        <span>Resources</span>
      </a>
      <span class="az-portal-app-item az-is-unavailable" aria-disabled="true" title="AzuntSiteStarter 예제 메뉴 · Hawaso에서 미구현">
        <span class="az-portal-app-icon az-app-icon-courses"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#courses"></use></svg></span>
        <span>Courses</span>
      </span>
      <span class="az-portal-app-item az-is-unavailable" aria-disabled="true" title="AzuntSiteStarter 예제 메뉴 · Hawaso에서 미구현">
        <span class="az-portal-app-icon az-app-icon-docs"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#docs"></use></svg></span>
        <span>Documentation</span>
      </span>
      <span class="az-portal-app-item az-is-unavailable" aria-disabled="true" title="AzuntSiteStarter 예제 메뉴 · Hawaso에서 미구현">
        <span class="az-portal-app-icon az-app-icon-protected"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#shield"></use></svg></span>
        <span>Protected docs</span>
      </span>
      <a class="az-portal-app-item" href="/Identity/Account/Manage">
        <span class="az-portal-app-icon az-app-icon-account"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#account"></use></svg></span>
        <span>Account</span>
      </a>
      <a class="az-portal-app-item" href="/products">
        <span class="az-portal-app-icon az-app-icon-products"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#products"></use></svg></span>
        <span>Products</span>
      </a>
      <span class="az-portal-app-item az-is-unavailable" aria-disabled="true" title="AzuntSiteStarter 예제 메뉴 · Hawaso에서 미구현">
        <span class="az-portal-app-icon az-app-icon-pricing"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#pricing"></use></svg></span>
        <span>Pricing</span>
      </span>
      <a class="az-portal-app-item" href="/DotNetNote">
        <span class="az-portal-app-icon az-app-icon-docs"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#docs"></use></svg></span>
        <span>Hawaso Board</span>
      </a>
      <a class="az-portal-app-item" href="/About">
        <span class="az-portal-app-icon az-app-icon-home"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#home"></use></svg></span>
        <span>About Hawaso</span>
      </a>
    </nav>

    <div class="az-portal-app-menu-divider"></div>
    <div class="az-portal-app-quick-links">
      <a href="/dashboard/resources">Browse resources <span aria-hidden="true">→</span></a>
      <span class="az-is-unavailable" title="Hawaso에서 미구현">Browse courses</span>
      <span class="az-is-unavailable" title="Hawaso에서 미구현">Getting started</span>
      <a href="/Identity/Account/Manage">Profile and account <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="az-portal-frame">
    <aside id="portalSidebar" class="az-portal-sidebar">
      <div class="az-portal-sidebar-tools" role="group" aria-label="Navigation tools">
        <button id="dashboardNavSearchToggle" class="az-portal-sidebar-tool" type="button"
                aria-label="Search menus" title="Search menus"
                aria-controls="dashboardNavSearchPanel" aria-expanded="false">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.5"/><path d="m13 13 4.4 4.4"/></svg>
          <span>Search</span>
        </button>
        <button id="dashboardNavCollapseAll" class="az-portal-sidebar-tool" type="button"
                aria-label="Collapse all menu groups" title="Collapse all menu groups">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 15.8h14M3 4.2h14m-11 8.3 4-4 4 4"/></svg>
          <span>Collapse All</span>
        </button>
      </div>
      <div class="az-portal-sidebar-scroll">
        @await Html.PartialAsync("~/Pages/Shared/_AzDashboardNavigation.cshtml", dashboardNavigation)
      </div>
      <nav class="az-portal-sidebar-fixed-links" aria-label="Quick shortcuts">
        <a href="/Home" data-az-document-nav="true" class="az-portal-sidebar-fixed-link az-is-hawaso" title="Hawaso" aria-label="Hawaso">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#webapp"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">Hawaso</span>
        </a>
        <a href="/DotNetNote" class="az-portal-sidebar-fixed-link az-is-dotnetnote" title="DotNetNote" aria-label="DotNetNote">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#devops"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">DotNetNote</span>
        </a>
        <a href="https://youtube.com/VisualAcademy" target="_blank" rel="noopener noreferrer" class="az-portal-sidebar-fixed-link az-is-visualacademy" title="VisualAcademy" aria-label="VisualAcademy">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#wireframe"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">VisualAcademy</span>
        </a>
      </nav>
      <button id="sidebarFooterToggle" class="az-portal-sidebar-footer-toggle" type="button" aria-label="Collapse navigation" title="Collapse navigation">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.4 4.8 7.2 10l5.2 5.2" /></svg>
      </button>
    </aside>

    <div id="dashboardNavFlyout"
         class="az-dashboard-nav-flyout"
         aria-hidden="true"
         aria-label="Dashboard submenu">
      <div id="dashboardNavFlyoutContent" class="az-dashboard-nav-flyout-content"></div>
    </div>

    <section id="dashboardNavSearchPanel" class="az-dashboard-nav-search-panel" hidden
             role="dialog" aria-label="Search dashboard menus">
      <div class="az-dashboard-nav-search-title">
        <strong>Search menus</strong>
        <button type="button" id="dashboardNavSearchClose" aria-label="Close menu search" title="Close">×</button>
      </div>
      <label class="az-dashboard-nav-search-label" for="dashboardNavSearchInput">Find a menu</label>
      <input id="dashboardNavSearchInput" type="search" autocomplete="off" placeholder="Search navigation..." />
      <div id="dashboardNavSearchResults" class="az-dashboard-nav-search-results" role="status" aria-live="polite"></div>
    </section>

    <main class="az-portal-content">
      <div class="az-hawaso-dashboard-content">
        <app><component type="typeof(App)" render-mode="ServerPrerendered" /></app>
      </div>
      <footer class="az-hawaso-dashboard-footer">
        Copyright &copy; @DateTime.Now.Year Hawaso. All rights reserved.
        <a href="/Home/Privacy">Privacy Policy</a>
      </footer>
    </main>
  </div>

  <div id="blazor-error-ui">
    <environment include="Staging,Production">An error has occurred. Reload the page to continue.</environment>
    <environment include="Development">An unhandled exception has occurred. See browser dev tools for details.</environment>
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
  </div>
  <script src="_framework/blazor.server.js"></script>
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.datatables.net/1.10.20/js/dataTables.bootstrap4.min.js" crossorigin="anonymous"></script>
  <script src="~/lib/ckeditor/ckeditor.js"></script>
  <script src="~/js/CkEditorFour.js"></script>
  <script src="~/js/azunt-dashboard.js" asp-append-version="true"></script>
  <script src="~/js/az-auth-ping.js"></script>
  <script>
    // Legacy Blazor CRUD pages still call these Bootstrap modal helpers.
    function closeModal(modalId) { window.jQuery && window.jQuery('#' + modalId).modal('hide'); }
    function showModal(modalId) { window.jQuery && window.jQuery('#' + modalId).modal('show'); }
  </script>
</body>
</html>
